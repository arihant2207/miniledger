# MiniLedger Expo App Environment Configuration
# Set to your laptop's LAN IPv4 from `ipconfig` (Windows) or `ifconfig` (macOS/Linux).
# Do not use localhost: on a physical phone, localhost is the phone itself.
# For Android emulator, use: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://YOUR_LAPTOP_IP:3000
