# MiniLedger Backend Configuration

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miniledger

# Authentication
# Must be at least 32 characters in length
JWT_SECRET=miniledger-super-secure-jwt-signing-key-32-chars
JWT_EXPIRES_IN=24h

# OTP Security settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=10
OTP_RATE_LIMIT_MAX_REQUESTS=3
